else if(id == "help")
{
	info "hel...p";
	elements = list();
	// Title
	elements.add({"type":"title","text":"👋 Welcome to Your Red Booth Task Manager Assistant!"});
	// Intro
	elements.add({"type":"text","text":"I'm here to help you manage, track and automate tasks efficiently 🚀\n\nBelow is everything you can do using this widget:"});
	// =========================
	// Core Features
	// =========================
	elements.add({"type":"title","text":"⚡ Core Features"});
	elements.add({"type":"text","text":"• Create tasks\n• Edit and update details\n• View tasks in one dashboard\n• Delete tasks instantly"});
	// =========================
	// Modules
	// =========================
	elements.add({"type":"title","text":"📌 Modules You Can Access"});
	elements.add({"type":"text","text":"📊 Workspaces – Create & manage workspaces\n📝 Tasks – Track deadlines & status\n📅 Projects – Monitor progress & timeline\n👥 Users – View user information"});
	// =========================
	// Slash Commands (Table)
	// =========================
	elements.add({"type":"title","text":"⚙ Slash Commands"});
	table_headers = list();
	table_headers.add("Command");
	table_headers.add("Description");
	table_rows = list();
	table_rows.add({"Command":"/createtask","Description":"Create Task with name, due etc"});
	table_rows.add({"Command":"/alltask","Description":"Show tasks with due date & status."});
	table_rows.add({"Command":"/edittask","Description":"Edit and update the tasks."});
	table_rows.add({"Command":"/viewtask","Description":"View a task in project"});
	elements.add({"type":"table","headers":table_headers,"rows":table_rows});
	// =========================
	// Menu Actions
	// =========================
	elements.add({"type":"title","text":"🧭 Menu Actions"});
	elements.add({"type":"text","text":"🔹 Create Task – Quickly add tasks\n" + "🔹 View Users – Explore user info\n" + "🔹 View Projects – View teams & deadlines\n" + "🔹 Alerts Enable – Turn ON notifications\n" + "🔹 Alerts Disable – Turn OFF notifications"});
	// =========================
	// Message Actions
	// =========================
	elements.add({"type":"title","text":"💬 Message Actions"});
	elements.add({"type":"text","text":"➕ Add Task – Create via chat message\n" + "💬 Add Comment – Add comments directly"});
	// =========================
	// Widget Features Summary
	// =========================
	elements.add({"type":"title","text":"🧩 Widget Features Overview"});
	elements.add({"type":"text","text":"📌 Dashboard – Manage tasks list\n" + "🗂 Workspace – Create / update details\n" + "📋 List View – Shows assigned users\n" + "📁 Projects – Monitor deadlines\n" + "📝 Tasks – Add / edit / delete\n" + "👥 Users – View across workspace"});
	// Return UI
	sections = list();
	sections.add({"id":1,"elements":elements});
	return {"type":"applet","sections":sections,"header":{"title":"📖 Help & Usage Guide"}};
}
return {"type":"applet","tabs":tabsArr,"active_tab":id,"sections":sections};
