
id = "dashboard";
imgUrls = {"https://images.pexels.com/photos/3854816/pexels-photo-3854816.jpeg","https://images.pexels.com/photos/3854816/pexels-photo-3854816.jpeg","https://images.pexels.com/photos/3854816/pexels-photo-3854816.jpeg","https://images.pexels.com/photos/131979/pexels-photo-131979.jpeg"};
if(target.containKey("id"))
{
	id = target.get("id");
}
sections = list();
tabsArr = {{"label":"Dashboard","id":"dashboard"},{"label":"Switch Project","id":"switchproject"},{"label":"Create Task","id":"createtask"},{"label":"Manage Tasks","id":"edittasks"},{"label":"View All Tasks","id":"viewtask"}};
if(id == "dashboard")
{
	header = {"title":"Dashboard"};
	sections = list();
	dataList = list();
	// CREATE TASK CARD
	eachData = Map();
	eachData.put("title","Create Task");
	eachData.put("description","Add a new task with required details.");
	eachData.put("image_url","https://images.pexels.com/photos/317356/pexels-photo-317356.jpeg");
	eachData.put("icon_url","https://images.pexels.com/photos/317356/pexels-photo-317356.jpeg");
	btn = list();
	btn.add({"label":"Create Task","type":"invoke.function","name":"createtaskform"});
	eachData.put("buttons",btn);
	dataList.add(eachData);
	// SWITCH PROJECT CARD
	eachData = Map();
	eachData.put("title","Switch Project");
	eachData.put("description","Switch your project");
	eachData.put("image_url","https://images.pexels.com/photos/131979/pexels-photo-131979.jpeg");
	eachData.put("icon_url","https://images.pexels.com/photos/131979/pexels-photo-131979.jpeg");
	btn = list();
	btn.add({"label":"Switch Project","type":"invoke.function","name":"switchprojectwid"});
	eachData.put("buttons",btn);
	dataList.add(eachData);
	// VIEW TASK CARD
	eachData = Map();
	eachData.put("title","View Task");
	eachData.put("description","Check the details of a task.");
	eachData.put("image_url","https://images.pexels.com/photos/1629212/pexels-photo-1629212.jpeg");
	eachData.put("icon_url","https://images.pexels.com/photos/1629212/pexels-photo-1629212.jpeg");
	btn = list();
	btn.add({"label":"View Task","type":"invoke.function","name":"viewtask"});
	eachData.put("buttons",btn);
	dataList.add(eachData);
	// EDIT TASK CARD
	eachData = Map();
	eachData.put("title","Manage Tasks");
	eachData.put("description","Update an existing task’s details.");
	eachData.put("image_url","https://images.pexels.com/photos/3854816/pexels-photo-3854816.jpeg");
	eachData.put("icon_url","https://images.pexels.com/photos/3854816/pexels-photo-3854816.jpeg");
	btn = list();
	btn.add({"label":"Manage Tasks","type":"invoke.function","name":"editwid"});
	eachData.put("buttons",btn);
	dataList.add(eachData);
	// ADDING CARDS TO SECTION
	elements = list();
	elements.add({"type":"cards","data":dataList,"style":{"view":"gallery","size":"small"}});
	sections.add({"id":1,"elements":elements});
	return {"type":"applet","tabs":tabsArr,"active_tab":id,"sections":sections,"header":header};
}
